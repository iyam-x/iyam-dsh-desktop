{
  "name": "@iyam/dsh-desktop-shell",
  "description": "iyam-dsh 桌面壳 companion：注入布局 CSS（主内容列顶部让位原生窗口按钮）+ 会话完成/等待输入的通知桥 + 自定义 scheme 导航兜底",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  }
}
