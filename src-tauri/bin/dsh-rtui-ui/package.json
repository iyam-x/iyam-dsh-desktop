{
  "name": "@iyam/dsh-rtui-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iyam-dsh 桌面壳主题插件：精选预设（石墨灰/午夜蓝/纸白/Sepia）+ 强调色自由取色 + 字体/圆角/密度自定义，注入 DSH web UI",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-store"]
    }
  }
}
